<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RootNamespace>StreamKit.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StreamKit.Core\StreamKit.Core.csproj" />
    <ProjectReference Include="..\..\src\StreamKit.Data\StreamKit.Data.csproj" />
    <ProjectReference Include="..\..\src\StreamKit.Web\StreamKit.Web.csproj" />
    <ProjectReference Include="..\..\src\StreamKit.Obs\StreamKit.Obs.csproj" />
    <ProjectReference Include="..\..\src\StreamKit.TikTok\StreamKit.TikTok.csproj" />
    <ProjectReference Include="..\..\src\StreamKit.App\StreamKit.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Los estáticos no fluyen por ProjectReference; se copian para probar el servidor real. -->
    <Content Include="..\..\src\StreamKit.Web\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
